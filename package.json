{
  "name": "climatizacao-api",
  "version": "1.0.0",
  "description": "API backend do sistema de climatização",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/webhooks/seed.js",
    "admin:create": "node scripts/create-admin.js",
    "seed:catalogo": "node src/webhooks/seed-catalogo.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "check": "node --check server.js && node --check src/app.js",
    "email:verify": "node scripts/verificar-smtp.js",
    "security:preflight": "node scripts/verificar-prontidao.js",
    "test:postgres": "node scripts/verificar-seguranca-postgres.js",
    "security:config": "node -r dotenv/config -e \"require('./src/config/security').validarConfiguracao()\"",
    "database:where": "node scripts/verificar-provedor-banco.js",
    "master:create": "node scripts/create-master.js",
    "test:orcamentos:postgres": "node scripts/verificar-orcamento-postgres.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "pg-connection-string": "^2.14.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
