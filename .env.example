# ==============================
# SERVIDOR
# ==============================
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=*

# ==============================
# BANCO DE DADOS (PostgreSQL)
# ==============================
DATABASE_URL=postgresql://usuario:senha@localhost:5432/clima_saas

# ==============================
# AUTENTICAÇÃO JWT
# ==============================
JWT_SECRET=sua_chave_secreta_aqui

# ==============================
# WHATSAPP — Meta Cloud API
# Painel: https://developers.facebook.com/apps
# ==============================
WHATSAPP_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=SEU_BUSINESS_ACCOUNT_ID
WHATSAPP_ACCESS_TOKEN=SEU_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=CRIE_UM_TOKEN_SECRETO_PARA_O_WEBHOOK
WHATSAPP_APP_SECRET=SEU_APP_SECRET_DA_META
# ID interno da empresa no ClimaSaaS que utiliza este número da Meta
WHATSAPP_EMPRESA_ID=1
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_TEMPLATE_LEMBRETE=lembrete_agendamento
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Número de teste da Meta (remetente — de onde as mensagens saem no sandbox)
WHATSAPP_TEST_SENDER=+15556465870

# Seu número cadastrado no painel Meta para RECEBER os testes
WHATSAPP_TEST_RECIPIENT=55XXXXXXXXXXX

# Recuperacao de senha (senha de app do Gmail somente no ambiente)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
PASSWORD_RESET_URL=https://13-58-212-142.nip.io/painel/
# Opcional: chave dedicada e estavel para cifrar a fila
EMAIL_QUEUE_SECRET=
# Chave estável dedicada para CPF/CNPJ. Defina antes de cadastrar clientes em produção.
DATA_ENCRYPTION_SECRET=
# Chave estável para links temporários de fotos.
FILE_URL_SECRET=

# Armazenamento de objetos (opcional). Sem bucket, fotos/PDFs continuam no PostgreSQL.
# Compatível com AWS S3, Cloudflare R2 e provedores S3-compatible.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
